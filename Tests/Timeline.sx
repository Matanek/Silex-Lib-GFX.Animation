use GFX.Animation
use GFX.Application
use GFX.Canvas
use GFX.Color
use GFX.ECS
use GFX.Resources
use GFX.Scene2D.Canvas as Canvas2D
use GFX.Scene2D.Transform as Transform2D
use GFX.Scene3D.Transform as Transform3D
use STD.Math

struct IntegrationState {
    var entity:ECS.Entity?
    var blocked_entity:ECS.Entity?
    var frames:int

    init() {
        self.entity = null
        self.blocked_entity = null
        self.frames = 0
    }
}

struct BlockingState {
    var entity:ECS.Entity?
    var frames:int

    init() {
        self.entity = null
        self.frames = 0
    }
}

struct Integration3DState {
    var entity:ECS.Entity?
    var frames:int

    init() {
        self.entity = null
        self.frames = 0
    }
}

struct AnimatedValue {
    let amount:float
}

func interpolate_animated_value(
    start:AnimatedValue,
    end:AnimatedValue,
    amount:float
) AnimatedValue {
    return AnimatedValue(amount:Math.lerp(start.amount, end.amount, amount))
}

func create_animated_entity(
    world:&Resources.World,
    state:&IntegrationState
) {
    let timeline = Animation.parallel([
        Animation.move_to(Math.Vec2(10.0, 0.0), 1.0),
        Animation.rotate_to(1.0, 1.0),
        Animation.scale_to(2.0, 1.0),
        Animation.color_to(Color.black(), 1.0),
    ])
    state.entity = world.spawn(ECS.EntityRecipe()
        ..with(Transform2D())
        ..with(Canvas2D(Canvas(), 1, 1))
        ..with(timeline.play())
    )
    let blocking = Animation.move_to(
        Math.Vec2(10.0, 0.0),
        1.0,
        easing:Animation.Easing.constant
    )
    state.blocked_entity = world.spawn(ECS.EntityRecipe()
        ..with(Transform2D())
        ..with(blocking.play())
    )
}

func verify_animation(
    world:@Resources.World,
    state:&IntegrationState,
    controller:&Application.Controller
) {
    state.frames++
    if state.frames < 3 { return }

    if let entity = state.entity {
        let transform = world.get<Transform2D>(entity)
        let canvas = world.get<Canvas2D>(entity)
        assert(transform.position.x > 0.0)
        assert(transform.rotation > 0.0)
        assert(transform.scale.x > 1.0)
        assert(transform.scale.y > 1.0)
        assert(canvas.color.r < 1.0)
    } else {
        assert(false)
    }
    if let blocked_entity = state.blocked_entity {
        let blocked = world.get<Transform2D>(blocked_entity)
        assert(blocked.position == Math.Vec2())
    } else {
        assert(false)
    }
    controller.stop()
}

func force_half_second(time:&Resources.FrameTime) {
    time.delta = 0.5
}

func create_animated_3d_entity(
    world:&Resources.World,
    state:&Integration3DState
) {
    let timeline = Animation.parallel([
        Animation.move_to(Math.Vec3(1.0, 0.5, 1.0), 1.0),
        Animation.rotate_to(
            Math.Quat.angle_axis(Math.pi() * 0.5, Math.Vec3.up()),
            1.0
        ),
        Animation.scale_to(2.0, 1.0),
    ])
    state.entity = world.spawn(ECS.EntityRecipe()
        ..with(Transform3D(position:Math.Vec3(-1.0, 0.5, -1.0)))
        ..with(timeline.play())
    )
}

func verify_animation_3d(
    world:@Resources.World,
    state:&Integration3DState,
    controller:&Application.Controller
) {
    state.frames++
    if state.frames < 3 { return }

    if let entity = state.entity {
        let transform = world.get<Transform3D>(entity)
        assert(transform.position == Math.Vec3(1.0, 0.5, 1.0))
        assert(transform.rotation.y > 0.0)
        assert(transform.scale == Math.Vec3(2.0))
    } else {
        assert(false)
    }
    controller.stop()
}

func create_blocking_entity(world:&Resources.World, state:&BlockingState) {
    let timeline = Animation.move_to(
        Math.Vec2(10.0, 0.0),
        1.0,
        easing:Animation.Easing.constant
    )
        ..ping_pong()
        ..loop()
    state.entity = world.spawn(ECS.EntityRecipe()
        ..with(Transform2D())
        ..with(timeline.play())
    )
}

func verify_blocking(
    world:@Resources.World,
    state:&BlockingState,
    controller:&Application.Controller
) {
    state.frames++
    if let entity = state.entity {
        let position = world.get<Transform2D>(entity).position
        if state.frames == 1 { assert(position == Math.Vec2()) }
        elif state.frames == 2 { assert(position == Math.Vec2(10.0, 0.0)) }
        elif state.frames == 3 { assert(position == Math.Vec2(10.0, 0.0)) }
        else {
            assert(position == Math.Vec2())
            controller.stop()
        }
    } else {
        assert(false)
    }
}

test "compose timeline actions through GFX.Animation" {
    let scale_pulse = Animation.sequence([
        Animation.scale_to(1.25, 0.5, easing:Animation.Easing.in_out),
        Animation.scale_to(Math.Vec2(1.0), 0.5,
            easing:Animation.Easing.in_out),
    ])
    let route = Animation.sequence([
        Animation.move_to(Math.Vec2(10.0, 0.0), 2.0),
        Animation.wait(1.0),
        Animation.move_to(Math.Vec2(10.0, 10.0), 2.0),
    ])
    let timeline = Animation.parallel([
        route,
        Animation.rotate_to(10.0, 4.0, easing:Animation.Easing.out),
        Animation.color_to(Color.black(), 3.0),
    ])

    assert(Math.nearly_equal(scale_pulse.duration(), 1.0))
    assert(Math.nearly_equal(route.duration(), 5.0))
    assert(Math.nearly_equal(timeline.duration(), 5.0))
}

test "advance a simple value tween manually" {
    var tween:Animation.Tween<float> = Animation.tween(
        0.0,
        10.0,
        2.0,
        easing:Animation.Easing.linear
    )

    assert(tween.value() == 0.0)
    assert(tween.advance(0.5) == 2.5)
    assert(!tween.finished())
    assert(tween.advance(1.5) == 10.0)
    assert(tween.finished())
    assert(tween.advance(1.0) == 10.0)

    tween.restart()
    assert(tween.value() == 0.0)
    assert(!tween.finished())
}

test "keep one tween type across several value animation steps" {
    var tween:Animation.Tween<Math.Vec2> = Animation.tween(Math.Vec2())
        ..to(Math.Vec2(10.0, 0.0), 1.0)
        ..wait(0.5)
        ..to(Math.Vec2(10.0, 10.0), 1.0,
            easing:Animation.Easing.in_out)

    assert(tween.duration() == 2.5)
    assert(tween.advance(1.0) == Math.Vec2(10.0, 0.0))
    assert(tween.advance(0.25) == Math.Vec2(10.0, 0.0))
    assert(tween.advance(0.5).y > 0.0)
    assert(tween.advance(0.75) == Math.Vec2(10.0, 10.0))
    assert(tween.finished())
}

test "loop a tween in both directions" {
    var tween = Animation.tween(0.0, 10.0, 1.0)
        ..ping_pong()
        ..loop()

    assert(tween.advance(0.5) == 5.0)
    assert(tween.advance(0.5) == 10.0)
    assert(tween.advance(0.5) == 5.0)
    assert(tween.advance(0.5) == 0.0)
    assert(!tween.finished())
}

test "seek backward through a composed ping-pong tween" {
    var tween = Animation.tween(0.0)
        ..to(10.0, 1.0)
        ..wait(0.5)
        ..to(20.0, 1.0)
        ..ping_pong()

    assert(tween.seek(3.0) == 15.0)
    assert(tween.seek(4.0) == 10.0)
    assert(tween.seek(5.0) == 0.0)
    assert(tween.finished())
}

test "animate built-in graphical value types" {
    var position = Animation.tween(Math.Vec3(), Math.Vec3(2.0), 1.0)
    var vector = Animation.tween(Math.Vec4(), Math.Vec4(2.0), 1.0)
    var color = Animation.tween(Color.black(), Color.white(), 1.0)
    var rotation = Animation.tween(
        Math.Quat.identity(),
        Math.Quat.angle_axis(Math.pi(), Math.Vec3.up()),
        1.0
    )

    assert(position.advance(0.5) == Math.Vec3(1.0))
    assert(vector.advance(0.5) == Math.Vec4(1.0))
    assert(color.advance(0.5) == Color.rgba(0.5, 0.5, 0.5, 1.0))
    assert(Math.nearly_equal(rotation.advance(0.5).length(), 1.0))
}

test "seek a tween and animate a custom value" {
    var tween = Animation.Tween<AnimatedValue>(
        AnimatedValue(amount:2.0),
        interpolate_animated_value
    )
        ..to(AnimatedValue(amount:6.0), 2.0)

    assert(tween.seek(1.0).amount == 4.0)
    assert(tween.seek(2.0).amount == 6.0)
    assert(tween.finished())
}

test "compose and apply 3D transform animations through GFX.Animation" {
    let route = Animation.parallel([
        Animation.move_to(Math.Vec3(1.0, 0.5, 1.0), 1.0),
        Animation.rotate_to(
            Math.Quat.angle_axis(Math.pi() * 0.5, Math.Vec3.up()),
            1.0
        ),
        Animation.scale_to(Math.Vec3(2.0), 1.0),
    ])
    assert(Math.nearly_equal(route.duration(), 1.0))

    var application = Application()
        ..add_resource(Integration3DState())
        ..add_plugin(Animation.Plugin())
        ..add_system(Application.Schedule.pre_update, force_half_second)
        ..add_system(Application.Schedule.startup, create_animated_3d_entity)
        ..add_after_system(Application.Schedule.update, verify_animation_3d)

    assert(application.run() == 0)
}

test "compose every public easing family" {
    let timeline = Animation.sequence([
        Animation.move_to(Math.Vec2(), 1.0, easing:Animation.Easing.constant),
        Animation.move_to(Math.Vec2(), 1.0, easing:Animation.Easing.linear),
        Animation.move_to(Math.Vec2(), 1.0, easing:Animation.Easing.in),
        Animation.move_to(Math.Vec2(), 1.0, easing:Animation.Easing.out),
        Animation.move_to(Math.Vec2(), 1.0, easing:Animation.Easing.in_out),
        Animation.move_to(Math.Vec2(), 1.0, easing:Animation.Easing.quadratic_in),
        Animation.move_to(Math.Vec2(), 1.0, easing:Animation.Easing.quadratic_out),
        Animation.move_to(Math.Vec2(), 1.0, easing:Animation.Easing.quadratic_in_out),
        Animation.move_to(Math.Vec2(), 1.0, easing:Animation.Easing.cubic_in),
        Animation.move_to(Math.Vec2(), 1.0, easing:Animation.Easing.cubic_out),
        Animation.move_to(Math.Vec2(), 1.0, easing:Animation.Easing.cubic_in_out),
        Animation.move_to(Math.Vec2(), 1.0, easing:Animation.Easing.sine_in),
        Animation.move_to(Math.Vec2(), 1.0, easing:Animation.Easing.sine_out),
        Animation.move_to(Math.Vec2(), 1.0, easing:Animation.Easing.sine_in_out),
        Animation.move_to(Math.Vec2(), 1.0, easing:Animation.Easing.back_in),
        Animation.move_to(Math.Vec2(), 1.0, easing:Animation.Easing.back_out),
        Animation.move_to(Math.Vec2(), 1.0, easing:Animation.Easing.back_in_out),
        Animation.move_to(Math.Vec2(), 1.0, easing:Animation.Easing.bounce_in),
        Animation.move_to(Math.Vec2(), 1.0, easing:Animation.Easing.bounce_out),
        Animation.move_to(Math.Vec2(), 1.0, easing:Animation.Easing.bounce_in_out),
    ])

    assert(Math.nearly_equal(timeline.duration(), 20.0))
}

test "animate Scene2D transform scale and canvas color through the plugin" {
    var application = Application()
        ..add_resource(IntegrationState())
        ..add_plugin(Animation.Plugin())
        ..add_system(Application.Schedule.startup, create_animated_entity)
        ..add_after_system(Application.Schedule.update, verify_animation)

    assert(application.run() == 0)
}

test "hold both blocking poses for one complete ping-pong direction" {
    var application = Application()
        ..add_resource(BlockingState())
        ..add_plugin(Animation.Plugin())
        ..add_system(Application.Schedule.pre_update, force_half_second)
        ..add_system(Application.Schedule.startup, create_blocking_entity)
        ..add_after_system(Application.Schedule.update, verify_blocking)

    assert(application.run() == 0)
}
