use GFX.Animation
use GFX.Plugins

test "consume GFX.Animation through public package boundaries" {
    let timeline = Animation.sequence([
        Animation.wait(0.25),
        Animation.wait(0.75),
    ])
    let plugin = Plugins.Animation()
    assert(timeline.duration() == 1.0)
    assert(plugin.id() == "GFX.Animation.Plugin")
}

test "consume manual value tweens through the public package boundary" {
    var tween:Animation.Tween<float> = Animation.tween(0.0)
        ..to(1.0, 0.5)
        ..wait(0.25)
        ..to(0.0, 0.5)

    assert(tween.duration() == 1.25)
    assert(tween.advance(0.25) == 0.5)
}
