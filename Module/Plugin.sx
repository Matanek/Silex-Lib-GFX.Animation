use GFX.Animation.Playback.Playback
use GFX.Application
use GFX.Application.Plugin as PluginProtocol
use GFX.Application.Schedule
use GFX.Application.Time as TimePlugin
use GFX.ECS
use GFX.Resources
use GFX.Scene2D.Canvas as Canvas2D
use GFX.Scene2D.Transform as Transform2D
use GFX.Scene3D.Transform as Transform3D

public struct Plugin:PluginProtocol {
    func id() str { return "GFX.Animation.Plugin" }

    func build(host:&Application) {
        host.add_plugin(ECS.Plugin())
        host.add_plugin(TimePlugin())
        if host.inherits_plugin(self.id()) {
            self.add_content_systems(host)
            return
        }
        host.extend_bundles(self)
        if !host.has_plugin("GFX.Application.BundleManager") ||
            host.inherits_plugin("GFX.Application.BundleManager")
        {
            self.add_content_systems(host)
        }
    }

    private func add_content_systems(host:&Application) {
        host.add_after_system(Schedule.pre_update, advance_playback, process_mode:Application.ProcessMode.always)
        host.add_system(Schedule.update, apply_transform_2d, process_mode:Application.ProcessMode.always)
        host.add_system(Schedule.update, apply_transform_3d, process_mode:Application.ProcessMode.always)
        host.add_system(Schedule.update, apply_canvas_color, process_mode:Application.ProcessMode.always)
    }
}

func advance_playback(
    time:@Resources.FrameTime,
    simulation:@Application.Simulation,
    query:ECS.Query<(ECS.Entity, &Playback)>
) {
    let paused = simulation.is_paused()
    for (entity, playback) in query {
        if !Application.should_process(playback.process_mode, paused) { continue }
        playback.advance(time.delta)
    }
}

func apply_transform_2d(simulation:@Application.Simulation, query:ECS.Query<(&Playback, &Transform2D)>) {
    let paused = simulation.is_paused()
    for (playback, transform) in query {
        if !Application.should_process(playback.process_mode, paused) { continue }
        if let position = playback.position(transform.position) {
            transform.position = position
        }
        if let rotation = playback.rotation(transform.rotation) {
            transform.rotation = rotation
        }
        if let scale = playback.scale(transform.scale) {
            transform.scale = scale
        }
    }
}

func apply_transform_3d(simulation:@Application.Simulation, query:ECS.Query<(&Playback, &Transform3D)>) {
    let paused = simulation.is_paused()
    for (playback, transform) in query {
        if !Application.should_process(playback.process_mode, paused) { continue }
        if let position = playback.position_3d(transform.position) {
            transform.position = position
        }
        if let rotation = playback.rotation_3d(transform.rotation) {
            transform.rotation = rotation
        }
        if let scale = playback.scale_3d(transform.scale) {
            transform.scale = scale
        }
    }
}

func apply_canvas_color(simulation:@Application.Simulation, query:ECS.Query<(&Playback, &Canvas2D)>) {
    let paused = simulation.is_paused()
    for (playback, canvas) in query {
        if !Application.should_process(playback.process_mode, paused) { continue }
        if let color = playback.color(canvas.color) { canvas.color = color }
    }
}
